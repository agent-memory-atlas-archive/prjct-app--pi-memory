{
  "name": "@prjct.app/pi-memory",
  "version": "0.1.0",
  "description": "Pi-native temporal memory and hybrid retrieval for agents.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "agent-memory",
    "rag",
    "vector-search",
    "local-first"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "exports": {
    ".": "./index.ts",
    "./vector": "./src/vector/index.ts",
    "./contracts": "./src/contracts/index.ts",
    "./sources": "./src/sources/index.ts"
  },
  "scripts": {
    "build": "rm -rf build && mkdir -p build && npm pack --ignore-scripts --pack-destination build >/dev/null && tar -xzf build/*.tgz -C build --strip-components=1 && rm -f build/*.tgz",
    "check": "tsc --noEmit && npm run check:immutable",
    "check:immutable": "node --import tsx scripts/check-immutable.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "eval": "node --import tsx scripts/eval.ts",
    "bench": "node --import tsx scripts/bench.ts",
    "check:package": "npm pack --dry-run --ignore-scripts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "sqlite-vec": "0.1.9"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "^22.19.0",
    "tsx": "^4.20.0",
    "typebox": "1.3.7",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prjct-app/pi-memory.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "src",
    "docs",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ]
}
